# Copy to .env.runtime (git-ignored); start-service.ps1 loads it.
APP_DASHBOARD_HOST=0.0.0.0
APP_DASHBOARD_PORT=8765
VEDA_REGISTRY=C:/Users/thedu/code/veda/.veda/projects/registry.json

# Dashboard account and session signing (generate long random values).
VEDA_DASHBOARD_USERNAME=thedubpalace
VEDA_DASHBOARD_PASSWORD=replace-with-a-long-random-password
VEDA_DASHBOARD_SESSION_SECRET=replace-with-32-plus-random-bytes
# Optional: alice:admin,bob:viewer (default: the account above is admin, others viewer)
DASHBOARD_USER_ROLES=
# 1 when browsers reach the dashboard over HTTPS (the public URL); 0 for plain-HTTP LAN use.
DASHBOARD_COOKIE_SECURE=1
DASHBOARD_LOGIN_RATE_ATTEMPTS=5
DASHBOARD_LOGIN_RATE_WINDOW_SECONDS=900

# Signed machine channel to temporal-service-orchestrator (readiness).
# Independent random values shared only with the orchestrator's deploy/.env.integration.
TEMPORAL_ORCHESTRATOR_URL=http://127.0.0.1:5016/temporal-ops
TEMPORAL_ORCHESTRATOR_TIMEOUT=10
DASHBOARD_SERVICE_TOKEN=replace-with-32-plus-random-bytes
DASHBOARD_ACTOR_SECRET=replace-with-a-different-32-plus-random-bytes

# Requirement review
REVIEW_TRACKER=mock
REVIEW_ALLOWLIST=thedubpalace
